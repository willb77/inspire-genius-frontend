# ── API Configuration ───────────────────────
VITE_API_BASE_URL=http://localhost:3000

# ── Agent Engine ────────────────────────────
VITE_AGENT_ENGINE_URL=http://localhost:8001
VITE_AGENT_WS_URL=ws://localhost:8001/ws/chat
VITE_ALEX_WEB_SOCKET_URL=ws://localhost:8001/ws/chat
VITE_AGENTS_WEBSOCKET_BASE_URL=ws://localhost:8001

# ── Security / Encryption ──────────────────
VITE_STORAGE_SECRET=           # Required — generate: python3 -c "import secrets; print(secrets.token_hex(16))"
VITE_CRYPTO_KEY=               # Required — generate: python3 -c "import secrets; print(secrets.token_hex(32))"
VITE_CRYPTO_SALT=              # Required — generate: python3 -c "import secrets; print(secrets.token_hex(16))"

# ── Observability ──────────────────────────
VITE_SENTRY_DSN=               # Optional — Sentry DSN for error tracking
VITE_SENTRY_ENVIRONMENT=development
VITE_APP_VERSION=0.0.0

# ── Feature Flags ──────────────────────────
VITE_MSW_ENABLED=false         # Set true for offline development with mocked API
VITE_HONOR_REPORT_EMAIL=false  # Honor: show the "Email report" button. Enable only where the server honor_report_email flag + a verified SES sender are live (staging-b).

# ── External Services ──────────────────────
VITE_VOICEDESK_AGENT_URL=https://vagentig.voicedeskai.co
VITE_VOICEDESK_ENABLED=false   # Set true to enable floating voice help widget

# ── Web Push Notifications ─────────────────
VITE_VAPID_PUBLIC_KEY=         # Optional — VAPID public key from backend

# Asset Library — per tier. Defaults in code point at dev; staging-b overrides
# both in .env.staging-b. Each tier's asset-library verifies super-admin against
# its OWN platform, so a cross-tier value fails closed (confidential never
# unlocks) rather than loudly.
VITE_ASSET_LIBRARY_API=https://assets-dev.inspiresgenius.com
VITE_ASSET_LIBRARY_TOOL_URL=https://ig-demo-public-videos.s3.amazonaws.com/library/index.html
