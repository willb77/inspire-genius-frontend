# API Base URL
VITE_API_BASE_URL=http://localhost:3000

# App Environment
VITE_APP_ENV=development

# Enable Mock Service Worker
VITE_MSW_ENABLED=false

# VAPID public key for Web Push Notifications
# Generate a VAPID key pair on the backend (e.g. with web-push library)
# and place the public key here.
VITE_VAPID_PUBLIC_KEY=

# VoiceDeskAI — voice help widget and tour narration
# Set VITE_VOICEDESK_ENABLED=true to enable the floating voice help widget.
# Leave blank or set to false to disable (widget will not render).
VITE_VOICEDESK_AGENT_URL=https://vagentig.voicedeskai.co
VITE_VOICEDESK_ENABLED=false

# Magic Auth + Agent Engine URLs
VITE_MAGIC_AUTH_URL=http://localhost:8001
VITE_AGENT_ENGINE_URL=http://localhost:8001
VITE_AGENT_WS_URL=ws://localhost:8001/ws
VITE_ALEX_WEB_SOCKET_URL=ws://localhost:8001/ws
VITE_AGENTS_WEBSOCKET_BASE_URL=ws://localhost:8001

# Encrypted storage keys — change in production
VITE_STORAGE_SECRET=change-me-in-production
VITE_CRYPTO_KEY=change-me-in-production
VITE_CRYPTO_SALT=change-me-in-production

# Sentry error tracking
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# App version (injected at build time in CI)
VITE_APP_VERSION=0.0.0
