# Staging-B Tier C Environment — dedicated account 918349930728
# Built with: cd inspire-genius-frontend && npm run build -- --mode staging-b
# Or: cp .env.staging-b .env.production.local && npm run build

VITE_NODE_ENV=production
# VITE_API_BASE_URL must route /v1/* to the API GW — the api-stable subdomain
# is the HTTP API custom domain wired in domain-stack.ts:494-509. The
# d2brmnoihf96ce.cloudfront.net distribution has no /v1/* behavior, so
# /v1/refresh-token, /v1/dashboard, /v1/documents/* would fall through to
# S3 default and return index.html — see docs/parity/matrix-2026-06-15-stagingb.md
# (Triage Findings) for the full Phase 0 diagnosis on 2026-06-15.
VITE_API_BASE_URL=https://api-stable.inspiresgenius.com
VITE_AGENT_ENGINE_URL=https://anj1cbzsf8.execute-api.us-east-1.amazonaws.com
VITE_MAGIC_AUTH_URL=https://anj1cbzsf8.execute-api.us-east-1.amazonaws.com
VITE_ALEX_WEB_SOCKET_URL=wss://lc77fxll95.execute-api.us-east-1.amazonaws.com/staging-b
# Direct WebSocket disabled in Tier C — no ws-stable.inspiresgenius.com ALB.
# WebSocket routes through API GW WebSocket API → ws-proxy → ECS.
VITE_AGENT_WS_DIRECT_URL=
VITE_AGENT_WS_URL=wss://lc77fxll95.execute-api.us-east-1.amazonaws.com/staging-b
VITE_AGENTS_WEBSOCKET_BASE_URL=wss://lc77fxll95.execute-api.us-east-1.amazonaws.com/staging-b

# Encrypted storage keys — TODO: rotate per-env when graduating from beta
VITE_STORAGE_SECRET=  # injected per-deploy; do not commit real values
VITE_CRYPTO_KEY=  # injected per-deploy; do not commit real values
VITE_CRYPTO_SALT=  # injected per-deploy; do not commit real values

# Sentry
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging-b

# App version (manual build; CI/CD will inject git SHA when wired)
VITE_APP_VERSION=staging-b-initial-2026-05-25

# VoiceDeskAI widget
VITE_VOICEDESK_AGENT_URL=https://vagentig.voicedeskai.co
VITE_VOICEDESK_ENABLED=false

# Login hardening (Phase 1 — Login Hardening Plan v2). Staging-b only for the
# soak window. When 'true' the Login page shows enhanced UX: visible 15-min TTL
# hint under magic-link, "Email not arriving?" fallback link, "Forgot password?"
# cross-link on the password screen, autocomplete tags on email/password inputs.
# Dev defaults to undefined (false) — same UI as today.
VITE_LOGIN_HARDENED=true

# New user surfaces (HomeV2 dashboard) default-ON on staging-b, matching dev.
# The in-page HomeSurfaceToggle and /home/classic escape hatch remain; an explicit
# localStorage `new_user_surfaces` value still overrides (localStorage > env default > OFF).
VITE_NEW_USER_SURFACES=true

# Honor (THF) Coach Workbench — enable the "Email report" button on staging-b.
# Gated in tandem with the server-side agent-engine `honor_report_email` flag
# (deployed true on staging-b) + the verified SES sender noreply@inspiresgenius.com.
# Dev leaves this unset (button hidden) until dev flips the server flag too.
VITE_HONOR_REPORT_EMAIL=true

# Team Development Studio (manager) — ENABLED on staging-b. The backend is now
# live here: growth-service (growth schema + baseline 001 + the async-compute
# migrations), agent-engine dossier compute, and the PRISM read-model
# (assessment-derived get_latest_prism). Demo data is seeded (willb77 manages a
# 6-member cohort with goals + PRISM). Previously dev-only ("until the backend
# is promoted"); that condition is now met, so the nav item + /manager/development
# routes are live on staging-b. Remove this line to hide the feature again.
VITE_FEATURE_TEAM_DEVELOPMENT=true

# ── Asset Library (Tier C) ───────────────────────────────────────────
# staging-b runs its OWN asset-library stack in account 918349930728. Both
# values must point at staging-b: the API verifies the caller's role against
# api-stable's /v1/me, so a dev endpoint here would reject every staging-b
# super admin and the confidential tier would silently never unlock.
#
# staging-b has NO public tier — every bucket in that account is
# block-all-public behind CloudFront OAC, and the public tier holds dev demo
# content that is not per-tier state. The library is confidential-only here,
# and the tool page is served by the existing admin-tools distribution.
VITE_ASSET_LIBRARY_API=https://assets.stable.inspiresgenius.com
VITE_ASSET_LIBRARY_TOOL_URL=https://d36dv6hsbekitk.cloudfront.net/library/index.html
